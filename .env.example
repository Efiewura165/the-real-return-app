# Contact form email delivery (app/api/contact/route.ts)
# Without RESEND_API_KEY, submissions are logged server-side but not delivered.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@therealreturn.com
CONTACT_FROM_EMAIL="The Real Return <onboarding@resend.dev>"

# Sanity CMS (sanity.config.ts, lib/sanity/*)
# Without NEXT_PUBLIC_SANITY_PROJECT_ID, every page falls back to the
# static content in content/*.ts — the site keeps working either way.
# Find/create a project ID at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity -> site revalidation webhook (app/api/revalidate/route.ts)
# Without this, editing content in the Studio won't appear on the live
# site until the next full redeploy. Set up in Sanity: Manage -> API ->
# Webhooks -> add https://yourdomain.com/api/revalidate, filter on all
# document types, and use this same value as the webhook's secret.
SANITY_REVALIDATE_SECRET=
