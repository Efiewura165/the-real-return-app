# Contact form email delivery (app/api/contact/route.ts)
# Without RESEND_API_KEY, submissions are logged server-side but not delivered.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@therealreturn.com
CONTACT_FROM_EMAIL="The Real Return <onboarding@resend.dev>"

# Sanity CMS (sanity.config.ts, lib/sanity/*)
# Without NEXT_PUBLIC_SANITY_PROJECT_ID, every page falls back to the
# static content in content/*.ts — the site keeps working either way.
# Find/create a project ID at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity -> site revalidation webhook (app/api/revalidate/route.ts)
# Without this, editing content in the Studio won't appear on the live
# site until the next full redeploy. Set up in Sanity: Manage -> API ->
# Webhooks -> add https://yourdomain.com/api/revalidate, filter on all
# document types, and use this same value as the webhook's secret.
SANITY_REVALIDATE_SECRET=

# Seed script only (scripts/seed-sanity.ts, `npm run seed`)
# A write token (Editor or Administrator rights) — create at
# Manage -> API -> Tokens. Never used by the app itself, only the
# one-time seed script, and never committed with a real value.
SANITY_API_WRITE_TOKEN=

# PayPal reservation deposit (lib/paypal.ts, app/api/paypal/*, Reserve page)
# Sandbox app credentials — create at https://developer.paypal.com/dashboard/applications.
# Without these, the deposit flow logs what would have happened and returns
# a mock order/capture id instead of calling PayPal, so the site keeps working.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Placeholder default — confirm the real amount with the client before launch.
RESERVATION_DEPOSIT_AMOUNT=500
RESERVATION_DEPOSIT_CURRENCY=USD

# DHL welcome-kit shipment (lib/dhl.ts, app/api/paypal/capture-order)
# Sandbox credentials — create at https://developer.dhl.com (MyDHL API).
# Without DHL_API_KEY, shipment creation is logged but not sent, and a mock
# tracking number is returned instead.
DHL_API_KEY=
DHL_ACCOUNT_NUMBER=
DHL_SHIP_FROM_NAME="The Real Return"
DHL_SHIP_FROM_ADDRESS_LINE=
DHL_SHIP_FROM_CITY=
DHL_SHIP_FROM_POSTAL_CODE=
DHL_SHIP_FROM_COUNTRY_CODE=US

# Stripe reservation deposit (lib/stripe.ts, app/api/stripe/*, Reserve page)
# Test-mode keys from https://dashboard.stripe.com/test/apikeys (client's account).
# Without STRIPE_SECRET_KEY, the card button still shows in development and the
# flow fulfills with a mock session id instead of charging; in production the
# button is hidden until the key is set.
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe/webhook endpoint. Locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# In production: Dashboard -> Developers -> Webhooks -> add endpoint, events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=
# Optional — absolute site URL for Stripe's success/cancel redirects.
# Defaults to the request's origin.
NEXT_PUBLIC_SITE_URL=
